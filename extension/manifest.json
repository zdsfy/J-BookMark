{
  "manifest_version": 3,
  "name": "我的书签 · Bookmark NAS",
  "version": "0.1.0",
  "description": "一键把当前网页保存到自托管的 bookmark-nas 书签服务，支持分类、标签、搜索与快速访问。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "我的书签",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "activeTab", "contextMenus", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B"
      },
      "description": "打开书签弹窗"
    }
  }
}